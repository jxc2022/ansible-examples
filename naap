---
- name: patch aap nprod
  hosts: localhost
  connection: local
  gather_facts: false

  vars: &patch_vars

    aap_nodes:
      - { host: "azaohaenu01.na.corp.yellow.com", role: execution }
      - { host: "azaohaenu02.na.corp.yellow.com", role: execution }
      - { host: "epmaaecmo3n01.ca.hq.yellow.com", role: execution }
      - { host: "azaohaacu01.na.corp.yellow.com", role: controller }
      - { host: "azaohaacu02.na.corp.yellow.com", role: controller }

    aap_role_order:
      execution: 10
      controller: 20

    aap_exclude_hosts: []

    aap_gateway_url: "https://aohub-aap-uat.yellow.com"
    aap_validate_certs: true

    aap_reboot_timeout: 900
    aap_reboot_connect_timeout: 5
    aap_reboot_reconnect_delay: 30

    # nprod gateway token, write scope. Replace with your vaulted value:
    #   ansible-vault encrypt_string '<token>' --name aap_token
    aap_token: !vault |
      $ANSIBLE_VAULT;1.1;AES256
      PASTE_YOUR_ENCRYPTED_TOKEN_HERE
    aap_drain_enabled: true
    aap_drain_roles: ["execution", "controller"]
    aap_drain_timeout: 1800          # seconds to wait for jobs to finish
    aap_drain_poll_interval: 15
    aap_api_settle_retries: 60       # after a reboot, wait for the API to answer
    aap_api_settle_delay: 10

    report_local_dir: "/tmp/reports"
    recipient:
      - jorge.chavez@yellow.com
      - Samarjeet.Sethi@yellow.com
      - Prasad.Murthy@yellow.com
      - Eknath.pawar@yellow.com
      # - Pakkiyaraj.Sethuraman@yellow.com

    report_email_enabled: true
    report_email_smtp_host: "smtp.yellow.com"
    report_email_smtp_port: 25
    report_email_smtp_secure: "try"    # never | starttls | ssl | try
    report_email_from: "jorge.chavez@yellow.com"
    report_email_to: "{{ recipient }}"
    report_email_attach_report: true

  tasks:
    - name: Sanity-check the targets
      ansible.builtin.assert:
        that:
          - aap_nodes | default([]) | length > 0
          - aap_nodes | map(attribute='host') | list | length ==
            aap_nodes | map(attribute='host') | unique | list | length
          - aap_nodes | map(attribute='role') | reject('in', aap_role_order.keys() | list) | list | length == 0
        fail_msg: >-
          Bad targets. Need at least one node, no duplicate hosts, and every
          role must be one of {{ aap_role_order.keys() | list | join(', ') }}.
          nodes={{ aap_nodes }}
        quiet: true
    - name: Attach an order weight to each node
      ansible.builtin.set_fact:
        aap_nodes_weighted: >-
          {{ aap_nodes_weighted | default([])
             + [ item | combine({'weight': aap_role_order[item.role]}) ] }}
      loop: "{{ aap_nodes }}"
      loop_control:
        label: "{{ item.host }} ({{ item.role }})"
    - name: Sort the nodes into patch order
      ansible.builtin.set_fact:
        aap_nodes_ordered: "{{ aap_nodes_weighted | sort(attribute='weight') }}"
    - name: Add the nodes to the patch group in order
      ansible.builtin.add_host:
        name: "{{ item.host }}"
        groups:
          - aap_patch
        node_role: "{{ item.role }}"
        node_instance: "{{ item.instance | default(item.host) }}"
      loop: "{{ aap_nodes_ordered }}"
      loop_control:
        label: "{{ item.host }} ({{ item.role }})"
      when: item.host not in aap_exclude_hosts | default([])
      changed_when: false
    - name: Show the patch order
      ansible.builtin.debug:
        msg: >-
          Patch order:
          {{ aap_nodes_ordered | rejectattr('host', 'in', aap_exclude_hosts | default([]))
             | map(attribute='host') | join('  ->  ') }}
    - name: Show what is being skipped
      ansible.builtin.debug:
        msg: >-
          NOT patched by this job (excluded): {{ aap_exclude_hosts | join(', ') }}.
      when: aap_exclude_hosts | default([]) | length > 0
    - name: Fail if nothing is left to patch
      ansible.builtin.assert:
        that:
          - aap_nodes_ordered | rejectattr('host', 'in', aap_exclude_hosts | default([])) | list | length > 0
        fail_msg: >-
          Every node in aap_nodes is in aap_exclude_hosts -- there is nothing
          for this job to patch.
        quiet: true
    - name: Warn if draining is on but no token was supplied
      ansible.builtin.debug:
        msg: >-
          aap_drain_enabled is true but AAP_TOKEN is empty. Nodes will be
          patched WITHOUT being drained -- running jobs on a rebooted node
          will fail.
      when:
        - aap_drain_enabled | bool
        - aap_token | default('', true) | length == 0
    - name: Seed the run-level status flags
      ansible.builtin.set_fact:
        patch_run_failed: false
- name: Patch the AAP nodes one at a time
  hosts: aap_patch
  become: true
  serial: 1
  max_fail_percentage: 0
  gather_facts: true
  vars:
    <<: *patch_vars
    aap_drain_this_node: >-
      {{ aap_drain_enabled | bool
         and node_role in aap_drain_roles
         and aap_token | default('', true) | length > 0 }}

  tasks:
    - name: Patch this node
      block:
        - name: Find this node's controller instance
          ansible.builtin.uri:
            url: "{{ aap_gateway_url }}/api/controller/v2/instances/?hostname={{ node_instance }}"
            method: GET
            headers:
              Authorization: "Bearer {{ aap_token }}"
            validate_certs: "{{ aap_validate_certs }}"
            status_code: 200
            timeout: 30
          delegate_to: localhost
          become: false
          no_log: true
          register: instance_lookup
          when: aap_drain_this_node | bool
        - name: Note the instance id
          ansible.builtin.set_fact:
            aap_instance_id: "{{ instance_lookup.json.results[0].id | default('') }}"
          when: aap_drain_this_node | bool
        - name: Take this node out of the instance pool
          ansible.builtin.uri:
            url: "{{ aap_gateway_url }}/api/controller/v2/instances/{{ aap_instance_id }}/"
            method: PATCH
            headers:
              Authorization: "Bearer {{ aap_token }}"
            body_format: json
            body:
              enabled: false
            validate_certs: "{{ aap_validate_certs }}"
            status_code: 200
            timeout: 30
          delegate_to: localhost
          become: false
          no_log: true
          register: instance_disabled
          when:
            - aap_drain_this_node | bool
            - aap_instance_id | default('', true) | length > 0
        - name: Wait for this node's running jobs to finish
          ansible.builtin.uri:
            url: "{{ aap_gateway_url }}/api/controller/v2/instances/{{ aap_instance_id }}/"
            method: GET
            headers:
              Authorization: "Bearer {{ aap_token }}"
            validate_certs: "{{ aap_validate_certs }}"
            status_code: 200
            timeout: 30
          delegate_to: localhost
          become: false
          no_log: true
          register: instance_state
          until: instance_state.json.jobs_running | default(0) | int == 0
          retries: "{{ (aap_drain_timeout | int / aap_drain_poll_interval | int) | round | int }}"
          delay: "{{ aap_drain_poll_interval }}"
          when:
            - aap_drain_this_node | bool
            - aap_instance_id | default('', true) | length > 0
        - name: Check for available package updates
          ansible.builtin.command: "dnf -q check-update"
          register: dnf_check
          changed_when: false
          failed_when: dnf_check.rc not in [0, 100]
        - name: Show available updates
          ansible.builtin.debug:
            var: dnf_check.stdout_lines
        - name: Apply operating system package updates
          ansible.builtin.dnf:
            name: "*"
            state: latest
            update_cache: true
          register: pkg_update
        - name: Record how many packages changed
          ansible.builtin.set_fact:
            pkg_changed_count: "{{ pkg_update.results | default([]) | length }}"
        - name: Show patch output
          ansible.builtin.debug:
            var: pkg_update.results
        - name: Reboot the node
          ansible.builtin.reboot:
            reboot_timeout: "{{ aap_reboot_timeout }}"
            connect_timeout: "{{ aap_reboot_connect_timeout }}"
            pre_reboot_delay: 5
            post_reboot_delay: "{{ aap_reboot_reconnect_delay }}"
            test_command: "systemctl is-system-running --wait || true"
        # On a single-node install the gateway IS the node that just rebooted,
        # so the API is not answering yet. Wait for it before re-enabling.
        - name: Wait for the platform API to answer after the reboot
          ansible.builtin.uri:
            url: "{{ aap_gateway_url }}/api/controller/v2/ping/"
            method: GET
            validate_certs: "{{ aap_validate_certs }}"
            status_code: 200
            timeout: 30
          delegate_to: localhost
          become: false
          register: api_back
          until: api_back.status | default(0) == 200
          retries: "{{ aap_api_settle_retries }}"
          delay: "{{ aap_api_settle_delay }}"
          failed_when: false
          when:
            - aap_drain_this_node | bool
            - instance_disabled is not skipped

        - name: Put this node back into the instance pool
          ansible.builtin.uri:
            url: "{{ aap_gateway_url }}/api/controller/v2/instances/{{ aap_instance_id }}/"
            method: PATCH
            headers:
              Authorization: "Bearer {{ aap_token }}"
            body_format: json
            body:
              enabled: true
            validate_certs: "{{ aap_validate_certs }}"
            status_code: 200
            timeout: 30
          delegate_to: localhost
          become: false
          no_log: true
          register: instance_enabled
          until: instance_enabled.status | default(0) == 200
          retries: 10
          delay: 15
          when:
            - aap_drain_this_node | bool
            - instance_disabled is not skipped
        - name: Record per-host result for the emailed report
          ansible.builtin.set_fact:
            patch_report_role: "{{ node_role }}"
            patch_report_status: "{{ 'ok' if aap_api_ok | default(true) | bool else 'unhealthy' }}"
            patch_report_packages: "{{ pkg_changed_count | default(0) }}"
            patch_report_reboot_performed: true
            patch_report_drained: "{{ aap_drain_this_node | bool }}"
            patch_report_api_ok: "{{ aap_api_ok | default(omit) }}"
        - name: Fail this node if a post-update check failed
          ansible.builtin.fail:
            msg: >-
              {{ inventory_hostname }} finished patching but a post-update
              check failed (api ok={{ aap_api_ok | default('not checked') }}).
          when: not aap_api_ok | default(true) | bool

      rescue:
        - name: Record the failure for the report
          ansible.builtin.set_fact:
            patch_report_role: "{{ node_role }}"
            patch_report_status: failed
            patch_report_failed_task: "{{ ansible_failed_task.name | default('unknown') }}"
            patch_report_error: >-
              {{ ansible_failed_result.msg
                 | default(ansible_failed_result.stderr | default('see job output')) }}
            patch_report_packages: "{{ pkg_changed_count | default(0) }}"
            patch_report_drained: "{{ aap_drain_this_node | bool }}"
        - name: Try to put the node back into the instance pool
          ansible.builtin.uri:
            url: "{{ aap_gateway_url }}/api/controller/v2/instances/{{ aap_instance_id }}/"
            method: PATCH
            headers:
              Authorization: "Bearer {{ aap_token }}"
            body_format: json
            body:
              enabled: true
            validate_certs: "{{ aap_validate_certs }}"
            status_code: 200
            timeout: 30
          delegate_to: localhost
          become: false
          no_log: true
          register: instance_reenabled
          until: instance_reenabled.status | default(0) == 200
          retries: "{{ aap_api_settle_retries }}"
          delay: "{{ aap_api_settle_delay }}"
          failed_when: false
          when:
            - aap_drain_this_node | bool
            - instance_disabled is defined
            - instance_disabled is not skipped
        - name: Flag the run as failed
          ansible.builtin.set_fact:
            patch_run_failed: true
          delegate_to: localhost
          delegate_facts: true
          become: false
        - name: Stop patching further nodes -- the report play still runs
          ansible.builtin.meta: end_play
- name: Render and email the patch run report
  hosts: localhost
  connection: local
  become: false
  gather_facts: true
  vars:
    <<: *patch_vars
    report_path: "{{ report_local_dir }}/aap_patch_report_{{ ansible_date_time.iso8601_basic_short }}.html"
    report_targets: "{{ groups['aap_patch'] | default([]) }}"
    status_colours:
      ok: "#1a7f37"
      unhealthy: "#bf8700"
      failed: "#cf222e"

  tasks:
    - name: Ensure the local report directory exists
      ansible.builtin.file:
        path: "{{ report_local_dir }}"
        state: directory
        mode: "0755"

    - name: Collect the final platform state
      ansible.builtin.uri:
        url: "{{ aap_gateway_url }}/api/controller/v2/ping/"
        method: GET
        validate_certs: "{{ aap_validate_certs }}"
        status_code: 200
        timeout: 30
      register: ping_final
      failed_when: false

    - name: Render patch report
      ansible.builtin.copy:
        dest: "{{ report_path }}"
        mode: "0644"
        content: |
          <!DOCTYPE html>
          <html>
          <head><meta charset="utf-8"><title>AAP patch report {{ ansible_date_time.date }}</title></head>
          <body style="margin:0;padding:24px;background:#f6f8fa;font-family:-apple-system,Segoe UI,Helvetica,Arial,sans-serif;color:#1f2328;">
          <div style="max-width:900px;margin:0 auto;background:#ffffff;border:1px solid #d0d7de;border-radius:6px;overflow:hidden;">

            <div style="padding:16px 20px;background:{{ '#cf222e' if patch_run_failed | default(false) | bool else '#1a7f37' }};color:#ffffff;">
              <div style="font-size:18px;font-weight:600;">Ansible Automation Platform 2.6 &mdash; OS patch report</div>
              <div style="font-size:14px;opacity:0.9;margin-top:4px;">
                {{ 'FAILED' if patch_run_failed | default(false) | bool else 'SUCCESS' }}
                &middot; {{ report_targets | length }} node{{ '' if report_targets | length == 1 else 's' }} targeted
              </div>
            </div>

            <table style="width:100%;border-collapse:collapse;font-size:13px;">
              <tr><td style="padding:6px 20px;color:#656d76;width:130px;">Generated</td><td style="padding:6px 20px;">{{ ansible_date_time.iso8601 }}</td></tr>
              <tr><td style="padding:6px 20px;color:#656d76;">Environment</td><td style="padding:6px 20px;font-family:ui-monospace,Menlo,Consolas,monospace;">{{ aap_gateway_url }}</td></tr>
              <tr><td style="padding:6px 20px;color:#656d76;">Mode</td><td style="padding:6px 20px;">drain + dnf update + reboot</td></tr>
          {% if aap_exclude_hosts | default([]) | length > 0 %}
              <tr><td style="padding:6px 20px;color:#656d76;">Excluded</td><td style="padding:6px 20px;color:#bf8700;">{{ aap_exclude_hosts | join(', ') }} (not patched)</td></tr>
          {% endif %}
            </table>

            <div style="padding:16px 20px 4px;font-size:15px;font-weight:600;border-top:1px solid #d0d7de;">Summary</div>
            <div style="padding:0 20px 16px;">
              <table style="width:100%;border-collapse:collapse;font-size:13px;">
                <tr style="background:#f6f8fa;">
                  <th align="left" style="padding:8px;border:1px solid #d0d7de;">Host</th>
                  <th align="left" style="padding:8px;border:1px solid #d0d7de;">Role</th>
                  <th align="left" style="padding:8px;border:1px solid #d0d7de;">Result</th>
                  <th align="right" style="padding:8px;border:1px solid #d0d7de;">Packages</th>
                  <th align="left" style="padding:8px;border:1px solid #d0d7de;">Drained</th>
                </tr>
          {% for h in report_targets %}
          {% set hv = hostvars[h] | default({}) %}
          {% set st = hv.patch_report_status | default('not attempted') | trim %}
                <tr>
                  <td style="padding:8px;border:1px solid #d0d7de;font-family:ui-monospace,Menlo,Consolas,monospace;">{{ h }}</td>
                  <td style="padding:8px;border:1px solid #d0d7de;">{{ hv.patch_report_role | default('-') }}</td>
                  <td style="padding:8px;border:1px solid #d0d7de;color:{{ status_colours[st] | default('#656d76') }};font-weight:600;">{{ st }}</td>
                  <td align="right" style="padding:8px;border:1px solid #d0d7de;">{{ hv.patch_report_packages | default('-') }}</td>
                  <td style="padding:8px;border:1px solid #d0d7de;">{{ 'yes' if hv.patch_report_drained | default(false) | bool else 'no' }}</td>
                </tr>
          {% endfor %}
              </table>
            </div>

            <div style="padding:16px 20px 4px;font-size:15px;font-weight:600;border-top:1px solid #d0d7de;">Detail</div>
            <div style="padding:0 20px 8px;">
          {% for h in report_targets %}
          {% set hv = hostvars[h] | default({}) %}
          {% set st = hv.patch_report_status | default('not attempted') | trim %}
              <div style="margin:12px 0;padding:12px;border:1px solid #d0d7de;border-left:4px solid {{ status_colours[st] | default('#656d76') }};border-radius:4px;">
                <div style="font-family:ui-monospace,Menlo,Consolas,monospace;font-weight:600;">{{ h }}</div>
                <div style="font-size:12px;color:#656d76;margin-bottom:8px;">{{ hv.patch_report_role | default('unknown role') }}</div>
                <table style="font-size:13px;border-collapse:collapse;">
                  <tr><td style="padding:2px 12px 2px 0;color:#656d76;">status</td><td style="color:{{ status_colours[st] | default('#656d76') }};font-weight:600;">{{ st }}</td></tr>
          {% if hv.patch_report_status is not defined %}
                  <tr><td colspan="2" style="padding:2px 0;color:#656d76;">never reached &mdash; the run stopped before it</td></tr>
          {% elif st == 'failed' %}
                  <tr><td style="padding:2px 12px 2px 0;color:#656d76;">failed task</td><td>{{ hv.patch_report_failed_task | default('unknown') }}</td></tr>
                  <tr><td style="padding:2px 12px 2px 0;color:#656d76;vertical-align:top;">error</td><td style="font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12px;">{{ hv.patch_report_error | default('see job output') | trim }}</td></tr>
                  <tr><td style="padding:2px 12px 2px 0;color:#656d76;">packages changed</td><td>{{ hv.patch_report_packages | default('-') }}</td></tr>
                  <tr><td style="padding:2px 12px 2px 0;color:#656d76;">drained first</td><td>{{ 'yes' if hv.patch_report_drained | default(false) | bool else 'no' }}</td></tr>
          {% else %}
                  <tr><td style="padding:2px 12px 2px 0;color:#656d76;">packages changed</td><td>{{ hv.patch_report_packages | default('-') }}</td></tr>
                  <tr><td style="padding:2px 12px 2px 0;color:#656d76;">reboot performed</td><td>yes</td></tr>
                  <tr><td style="padding:2px 12px 2px 0;color:#656d76;">drained first</td><td>{{ 'yes' if hv.patch_report_drained | default(false) | bool else 'no' }}</td></tr>
                  <tr><td style="padding:2px 12px 2px 0;color:#656d76;">api check</td><td>{{ hv.patch_report_api_ok | default('not checked') }}</td></tr>
          {% endif %}
                </table>
              </div>
          {% endfor %}
            </div>

            <div style="padding:16px 20px 4px;font-size:15px;font-weight:600;border-top:1px solid #d0d7de;">Platform state after the run</div>
            <div style="padding:0 20px 16px;">
          {% if ping_final.status | default(0) == 200 %}
              <table style="width:100%;border-collapse:collapse;font-size:13px;">
                <tr style="background:#f6f8fa;">
                  <th align="left" style="padding:8px;border:1px solid #d0d7de;">Instance</th>
                  <th align="left" style="padding:8px;border:1px solid #d0d7de;">Type</th>
                  <th align="right" style="padding:8px;border:1px solid #d0d7de;">Capacity</th>
                  <th align="left" style="padding:8px;border:1px solid #d0d7de;">Heartbeat</th>
                </tr>
          {% for i in ping_final.json.instances | default([]) %}
                <tr>
                  <td style="padding:8px;border:1px solid #d0d7de;font-family:ui-monospace,Menlo,Consolas,monospace;">{{ i.node }}</td>
                  <td style="padding:8px;border:1px solid #d0d7de;">{{ i.node_type | default('-') }}</td>
                  <td align="right" style="padding:8px;border:1px solid #d0d7de;{{ 'color:#cf222e;font-weight:600;' if i.capacity | default(0) | int == 0 else '' }}">{{ i.capacity | default('-') }}</td>
                  <td style="padding:8px;border:1px solid #d0d7de;font-size:12px;">{{ i.heartbeat | default('-') }}</td>
                </tr>
          {% endfor %}
              </table>
          {% if ping_final.json.instances | default([]) | selectattr('capacity', 'equalto', 0) | list | length > 0 %}
              <p style="margin:12px 0 0;padding:10px;background:#fff8c5;border:1px solid #d4a72c;border-radius:4px;font-size:13px;">
                An instance is reporting zero capacity &mdash; it may still be disabled in the pool. Check
                <span style="font-family:ui-monospace,Menlo,Consolas,monospace;">/api/controller/v2/instances/</span> before closing out the change.
              </p>
          {% endif %}
          {% else %}
              <p style="margin:0;padding:10px;background:#ffebe9;border:1px solid #cf222e;border-radius:4px;font-size:13px;">
                Could not reach {{ aap_gateway_url }}/api/controller/v2/ping/ (status {{ ping_final.status | default('no response') }}).
                Check the platform before closing out the change.
              </p>
          {% endif %}
            </div>

            <div style="padding:12px 20px;background:#f6f8fa;border-top:1px solid #d0d7de;font-size:12px;color:#656d76;">
              This run patched the RHEL hosts only. AAP itself is unchanged &mdash; the container images are the
              same tags as before. A node missing from the instance list above is worth a look even where the
              overall result is SUCCESS.
            </div>

          </div>
          </body>
          </html>

    - name: Show the patch result
      ansible.builtin.debug:
        msg: >-
          {{ 'FAILED' if patch_run_failed | default(false) | bool else 'SUCCESS' }} --
          {% for h in report_targets %}
          {{ h }}={{ hostvars[h].patch_report_status | default('not attempted') | trim }}
          ({{ hostvars[h].patch_report_packages | default(0) }} pkgs){{ ', ' if not loop.last else '' }}
          {%- endfor %} -- report: {{ report_path }}

    - name: Email patch report
      no_log: true
      community.general.mail:
        host: "{{ report_email_smtp_host }}"
        port: "{{ report_email_smtp_port }}"
        secure: "{{ report_email_smtp_secure }}"
        from: "{{ report_email_from }}"
        to: "{{ report_email_to if report_email_to is string else report_email_to | join(',') }}"
        subject: >-
          [{{ 'FAILED' if patch_run_failed | default(false) | bool else 'OK' }}]
          AAP patch report {{ aap_gateway_url | regex_replace('^https?://', '') }}
          - {{ ansible_date_time.date }}
        subtype: html
        body: "{{ lookup('file', report_path) }}"
        attach: "{{ [report_path] if report_email_attach_report | bool else omit }}"
      when: report_email_enabled | bool

    - name: Fail the run if any node failed to patch
      ansible.builtin.fail:
        msg: "One or more nodes failed to patch. See the report at {{ report_path }}."
      when: patch_run_failed | default(false) | bool

