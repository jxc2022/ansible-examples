# Get-ADGroupMembers-Email.ps1
# Finds every AD group matching a wildcard, pulls members of each, and emails the
# combined list as a CSV attachment.

$groupFilter = "*yellow*"          # wildcard match against group Name, e.g. "*yellow*" or "yellow-na-*"
$adServer    = "na.corp.yellow.com"
$dateStamp   = Get-Date -Format "yyyy-MM-dd"

# Find every group whose name matches the wildcard.
$groups = Get-ADGroup -Filter "Name -like '$groupFilter'" -Server $adServer

if (-not $groups) {
    Write-Error "No AD groups matched filter '$groupFilter'"
    exit
}

# Loop through each matching group and pull its (recursive) user members, tagging
# each row with the group it came from so the combined CSV stays traceable.
$groupMembers = foreach ($group in $groups) {
    Get-ADGroupMember -Identity $group -Recursive -Server $adServer |
        Where-Object { $_.objectClass -eq "user" } |
        ForEach-Object {
            Get-ADUser -Identity $_.SamAccountName -Server $adServer -Properties DisplayName |
            Select-Object @{Name = "GroupName"; Expression = { $group.Name }}, SamAccountName, DisplayName
        }
}
$groupMembers = $groupMembers | Sort-Object GroupName, SamAccountName

# Table version for a quick visual in the body (kept separate from the plain-text $Body below —
# reusing the same name would silently overwrite it, since PowerShell variable names are
# case-insensitive).
$tableText = $groupMembers | Format-Table -AutoSize | Out-String

# Export to CSV so we have an actual file to attach (Send-MailMessage -Attachments needs a
# file path, not an object array).
$AttachmentPath = Join-Path $env:TEMP "ad-members-$dateStamp.csv"
$groupMembers | Export-Csv -Path $AttachmentPath -NoTypeInformation

# Email settings
$From = "jorge.chavez@yellow.com"
$To = @("jorge.chavez@yellow.com")
$Subject = "AD members $dateStamp"
$Body = "AD members for groups matching '$groupFilter' ($($groups.Count) group(s) found) as of $dateStamp. Full list attached as CSV.`n`n$tableText"
$SMTPServer = "ndhmail.yellow.com"
$SMTPPort = 587
$UseSSL = $false

# Load encrypted credentials
$CredentialPath = "C:\jorgesmtp_creds.xml"
if (-Not (Test-Path $CredentialPath)) {
    Write-Error "Credential file not found at $CredentialPath"
    exit
}

try {
    $Credential = Import-Clixml -Path $CredentialPath
    Send-MailMessage -From $From -To $To -Subject $Subject -Body $Body `
        -SmtpServer $SMTPServer -Port $SMTPPort -UseSsl:$UseSSL `
        -Attachments $AttachmentPath -DeliveryNotificationOption OnSuccess `
        -Credential $Credential
    Write-Output "Email sent successfully to $To"
}
catch {
    Write-Error "Failed to send email: $_"
}
finally {
    Remove-Item -Path $AttachmentPath -ErrorAction SilentlyContinue
}
