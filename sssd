---
# sssd_access_report.yml
# Reports which AD groups are allowed to log in per host, based on the SSSD access_provider
# (read from /etc/sssd/sssd.conf plus /etc/sssd/conf.d/*.conf drop-ins):
#   access_provider = permit  -> groups from /etc/security/access.conf
#                                (also used when a domain has NO access_provider line,
#                                 because permit is the SSSD default)
#   access_provider = simple  -> groups from simple_allow_groups in sssd.conf / drop-ins
# Output: CSV with one row per group per host; source_file is the file the group came from.
#
# Run:
#   ansible-playbook -i inventory sssd_access_report.yml \
#     -e mail_to=you@example.com -e smtp_host=relay.example.com

- name: SSSD access provider / allowed group report
  hosts: all
  become: true
  gather_facts: true
  gather_subset:
    - min

  vars:
    report_path: /tmp/sssd_access_report.csv
    sssd_conf_path: /etc/sssd/sssd.conf
    sssd_dropin_dir: /etc/sssd/conf.d
    access_conf_path: /etc/security/access.conf

    # Email settings - report is written and mailed (run_once) on localhost, i.e. the execution
    # environment on the AAP execution node, so smtp_host must be reachable from that node
    mail_to: "CHANGEME@example.com"          # comma-separated string or list
    mail_from: "aap-reports@{{ ansible_facts['domain'] | default('localhost', true) }}"
    mail_subject: "SSSD access group report - {{ ansible_facts['date_time']['date'] | default('') }}"
    smtp_host: localhost
    smtp_port: 25
    smtp_secure: try                          # always | never | try | starttls
    # smtp_username / smtp_password: set (vault / AAP credential) only if the relay needs auth

    # access.conf entries that should not be reported as groups
    access_conf_exclude:
      - root
      - ALL
      - EXCEPT
      - LOCAL
    # true = only report "(group)" and "@netgroup" entries, ignore bare names (could be users)
    access_conf_groups_only: false

    nl: "\n"                                  # real newline for use inside the templates below

    # ---- lazily evaluated per host ----
    report_hostname: "{{ ansible_facts['fqdn'] | default(inventory_hostname) }}"
    os_version: "{{ ansible_facts['distribution'] | default('unknown') }} {{ ansible_facts['distribution_version'] | default('') }}"

    # sssd.conf first, then drop-ins in alphabetical order (same order SSSD loads them)
    sssd_file_results: "{{ [sssd_raw] + (sssd_dropin_raw.results | default([])) }}"

    sssd_all_text: >-
      {{ sssd_file_results
         | map(attribute='content', default='')
         | map('b64decode') | join(nl) }}

    access_text: "{{ access_raw.content | default('') | b64decode }}"

    sssd_domains: >-
      {{ sssd_all_text
         | regex_findall('^[ \t]*\[domain/([^\]\n]+)\]', multiline=True)
         | map('trim') | unique | list }}

    # One provider per [domain/...] section; last definition wins (drop-ins override
    # sssd.conf); a domain with no access_provider line is "permit" (SSSD default).
    access_providers_csv: |-
      {%- set ns = namespace(p=[]) -%}
      {%- for d in sssd_domains -%}
      {%-   set body = sssd_all_text
              | regex_findall('(?ms)^[ \t]*\[domain/' ~ (d | regex_escape) ~ '\][ \t\r]*$(.*?)(?=^[ \t]*\[|\Z)')
              | join(nl) -%}
      {%-   set found = body | regex_findall('^[ \t]*access_provider[ \t]*=[ \t]*(\S+)', multiline=True) -%}
      {%-   set ns.p = ns.p + [(found | last | lower) if found else 'permit'] -%}
      {%- endfor -%}
      {{ ns.p | unique | join(',') }}

    access_providers: "{{ access_providers_csv.split(',') | select | list }}"

    # Allowed entries from access.conf:
    #   "+ : a (b) @c : origins"            -> a, b, c
    #   "- : ALL EXCEPT root (b) : origins" -> b   (everything after EXCEPT is allowed)
    access_groups_raw: |-
      {%- set ns = namespace(t=[]) -%}
      {%- for line in access_text.splitlines() -%}
      {%-   set l = line.strip() -%}
      {%-   set parts = l.split(':') -%}
      {%-   if l and not l.startswith('#') and parts | length >= 3 -%}
      {%-     set perm = parts[0].strip() -%}
      {%-     set users = parts[1] -%}
      {%-     if perm == '-' and 'EXCEPT' in users.split() -%}
      {%-       set users = users.split('EXCEPT', 1)[1] -%}
      {%-     elif perm != '+' -%}
      {%-       set users = '' -%}
      {%-     endif -%}
      {%-     set ns.t = ns.t + (users | regex_findall('\(([^)]+)\)')) -%}
      {%-     set bare = (users | regex_replace('\([^)]*\)', ' ')).split() -%}
      {%-     if access_conf_groups_only | bool -%}
      {%-       set bare = bare | select('match', '@') | list -%}
      {%-     endif -%}
      {%-     set ns.t = ns.t + bare -%}
      {%-   endif -%}
      {%- endfor -%}
      {{ ns.t | join(nl) }}

    access_groups: >-
      {{ access_groups_raw.split(nl)
         | map('trim') | select
         | reject('in', access_conf_exclude)
         | unique | list }}

    host_rows: |-
      {%- set ns = namespace(rows=[]) -%}
      {%- set base = '"' ~ report_hostname ~ '","' ~ (os_version | trim) ~ '"' -%}
      {%- if 'simple' in access_providers -%}
      {%-   for f in sssd_file_results -%}
      {%-     set groups = (f.content | default('') | b64decode)
                | regex_findall('^[ \t]*simple_allow_groups[ \t]*=[ \t]*(.+)$', multiline=True)
                | map('split', ',') | flatten
                | map('trim') | select | unique | list -%}
      {%-     for g in groups -%}
      {%-       set ns.rows = ns.rows + [base ~ ',"simple","' ~ (f.source | default(sssd_conf_path)) ~ '","' ~ g ~ '"'] -%}
      {%-     endfor -%}
      {%-   endfor -%}
      {%- endif -%}
      {%- if 'permit' in access_providers -%}
      {%-   for g in access_groups -%}
      {%-     set ns.rows = ns.rows + [base ~ ',"permit","' ~ access_conf_path ~ '","' ~ g ~ '"'] -%}
      {%-   endfor -%}
      {%- endif -%}
      {%- if ns.rows | length == 0 -%}
      {%-   set ns.rows = [base ~ ',"' ~ (access_providers | join('|') | default('not_found', true)) ~ '","n/a",""'] -%}
      {%- endif -%}
      {{ ns.rows | join(nl) }}

  tasks:
    - name: Read sssd.conf
      ansible.builtin.slurp:
        src: "{{ sssd_conf_path }}"
      register: sssd_raw
      failed_when: false

    - name: Find sssd drop-ins
      ansible.builtin.find:
        paths: "{{ sssd_dropin_dir }}"
        patterns: "*.conf"
        file_type: file
        hidden: false
      register: sssd_dropins
      failed_when: false

    - name: Read sssd drop-ins
      ansible.builtin.slurp:
        src: "{{ item }}"
      loop: "{{ sssd_dropins.files | default([]) | map(attribute='path') | sort }}"
      register: sssd_dropin_raw
      failed_when: false

    - name: Read access.conf (access_provider = permit, explicit or default)
      ansible.builtin.slurp:
        src: "{{ access_conf_path }}"
      register: access_raw
      failed_when: false
      when: "'permit' in access_providers"

    - name: Build CSV rows for this host
      ansible.builtin.set_fact:
        csv_rows: "{{ host_rows }}"

    - name: Show what was detected
      ansible.builtin.debug:
        msg:
          - "sssd domains: {{ sssd_domains | join(', ') | default('none found', true) }}"
          - "access_provider: {{ access_providers | join(', ') | default('not_found', true) }}"
          - "rows: {{ csv_rows.split(nl) | length }}"

    - name: Write CSV report
      ansible.builtin.copy:
        dest: "{{ report_path }}"
        mode: "0644"
        content: |
          hostname,os_version,access_provider,source_file,group
          {% for h in ansible_play_hosts_all %}
          {{ hostvars[h].csv_rows | default('"' ~ h ~ '","unknown","unreachable_or_failed","n/a",""') }}
          {% endfor %}
      run_once: true
      delegate_to: localhost
      become: false

    - name: Email CSV report
      community.general.mail:
        host: "{{ smtp_host }}"
        port: "{{ smtp_port }}"
        secure: "{{ smtp_secure }}"
        username: "{{ smtp_username | default(omit) }}"
        password: "{{ smtp_password | default(omit) }}"
        from: "{{ mail_from }}"
        to: "{{ mail_to }}"
        subject: "{{ mail_subject }}"
        body: |
          SSSD access provider / allowed group report attached.

          Hosts in play: {{ ansible_play_hosts_all | length }}
          Hosts reported: {{ ansible_play_hosts | length }}
        attach:
          - "{{ report_path }}"
      run_once: true
      delegate_to: localhost
      become: false
      tags: email
