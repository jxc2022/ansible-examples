---
- name: Create snapshots for Azure VMs from survey input
  hosts: localhost
  connection: local
  gather_facts: yes          # needed for ansible_date_time (replaces the pipe lookup)
  collections:
    - azure.azcollection
  vars_files:
    - azure_creds.yml

  vars:
    snapshot_name: "{{ snapshot_name | default('snap') }}"

    mail_to:
      - "jorge.chavez@mckesson.com"
      - "Prasad.Murthy@McKesson.com"
      - "Eknath.pawar@mckesson.com"
      - "Malliswari.S@McKesson.com"

    vm_list_clean:
      - epmcapcmo3p01.ca.hq.medisna.com
      - epmcapmddcp01.oc.mckesson.com
      - epmcapuddcp01.na.corp.mckesson.com
      - epmcapazp01.na.corp.mckesson.com
      - epmsatmddcp01.oc.mckesson.com

  # Auth for the azure_rm_* modules. Without this they fall back to env vars /
  # ~/.azure/credentials and silently use the wrong (or no) identity.
  environment:
    AZURE_CLIENT_ID: "{{ azure_client_id }}"
    AZURE_SECRET: "{{ azure_client_secret }}"
    AZURE_TENANT: "{{ azure_tenant_id }}"

  tasks:
    - name: Authenticate Azure CLI
      ansible.builtin.shell: |
        az login --service-principal \
          -u "{{ azure_client_id }}" \
          -p "{{ azure_client_secret }}" \
          --tenant "{{ azure_tenant_id }}" \
          --only-show-errors
      changed_when: false
      no_log: true            # keeps the SP secret out of the job log

    - name: Ensure resource-graph CLI extension is present
      ansible.builtin.shell: az extension add --name resource-graph --only-show-errors --yes
      changed_when: false
      failed_when: false

    # --- FIX 1: single timestamp, computed once -------------------------------
    # The original called lookup('pipe','date ...') separately in the create task
    # and again in the report task. Across a minute boundary the CSV recorded a
    # snapshot name that did not exist in Azure.
    - name: Set one snapshot timestamp for the whole run
      ansible.builtin.set_fact:
        snapshot_ts: "{{ ansible_date_time.date | regex_replace('-','') }}{{ ansible_date_time.hour }}{{ ansible_date_time.minute }}"

    # --- FIX 2: match on the Azure resource name, not the FQDN ----------------
    # This is why every task said "skipping". Azure VM resource names are the
    # short hostname (epmcapcmo3p01). `name =~ "epmcapcmo3p01.ca.hq.medisna.com"`
    # matched zero rows, vm_info came back [], and every downstream loop skipped.
    - name: Derive short VM names
      ansible.builtin.set_fact:
        vm_short_names: "{{ vm_list_clean | map('regex_replace', '\\..*$', '') | list }}"

    - name: Build quoted name list for Kusto
      ansible.builtin.set_fact:
        name_in_clause: "{{ vm_short_names | map('regex_replace', '^(.*)$', '\"\\1\"') | join(',') }}"

    # Disk metadata is pulled straight from the graph, so azure_rm_virtualmachine_info
    # and the fragile results[idx] index alignment are no longer needed.
    - name: Build Kusto query
      ansible.builtin.set_fact:
        full_query: >-
          Resources
          | where type =~ "microsoft.compute/virtualmachines"
          | where name in~ ({{ name_in_clause }})
          | project name, resourceGroup, subscriptionId, location,
                    osType   = tostring(properties.storageProfile.osDisk.osType),
                    diskKey  = tolower(tostring(properties.storageProfile.osDisk.managedDisk.id))
          | join kind=leftouter (
              Resources
              | where type =~ "microsoft.compute/disks"
              | project diskKey = tolower(id), diskId = id, skuName = tostring(sku.name)
            ) on diskKey
          | project name, resourceGroup, subscriptionId, location, osType, diskId, skuName

    # --- FIX 3: `quote` under ansible.builtin.command ------------------------
    # command does not spawn a shell, so | quote injected literal single quotes
    # into the query text. Use shell (quoting is then meaningful) and raise the
    # page size off the 100-row default.
    - name: Query Azure Resource Graph
      ansible.builtin.shell: >
        az graph query -q {{ full_query | quote }} --first 1000 -o json --only-show-errors
      register: vm_info_raw
      changed_when: false

    - name: Parse JSON output
      ansible.builtin.set_fact:
        vm_info: "{{ (vm_info_raw.stdout | from_json).data }}"

    # --- FIX 4: fail loudly instead of silently producing an empty report -----
    - name: Report VMs that were not found in the graph
      ansible.builtin.debug:
        msg: "NOT FOUND in Azure Resource Graph: {{ missing }}"
      vars:
        missing: "{{ vm_short_names | difference(vm_info | map(attribute='name') | list) }}"
      when: missing | length > 0

    - name: Fail if no VMs resolved
      ansible.builtin.fail:
        msg: >-
          Resource Graph returned 0 VMs for {{ vm_short_names | join(', ') }}.
          Check that the service principal has Reader on the target subscriptions
          and that the names match the Azure resource names (not FQDNs).
      when: vm_info | length == 0

    - name: Fail if any VM has no resolvable OS disk
      ansible.builtin.fail:
        msg: "VMs with no managed OS disk resolved: {{ bad | map(attribute='name') | list }}"
      vars:
        bad: "{{ vm_info | rejectattr('diskId', 'defined') | list }}"
      when: bad | length > 0

    # --- FIX 5: snapshot name capped at Azure's 80-char limit -----------------
    - name: Create snapshot
      azure.azcollection.azure_rm_snapshot:
        subscription_id: "{{ item.subscriptionId }}"
        resource_group: "{{ item.resourceGroup }}"
        name: "{{ (item.name ~ '-' ~ snapshot_name)[:67] }}-{{ snapshot_ts }}"
        location: "{{ item.location }}"
        creation_data:
          create_option: Copy
          source_uri: "{{ item.diskId }}"
      loop: "{{ vm_info }}"
      register: snapshot_results
      ignore_errors: true       # kept, but the outcome is now recorded per VM

    # --- FIX 6: report real status, not assumed success ----------------------
    # Previously every VM appeared in the CSV as if it had snapshotted, even when
    # the module errored, because the report was rebuilt from vm_info.
    - name: Build snapshot report rows
      ansible.builtin.set_fact:
        snapshot_table: >-
          {{
            (snapshot_table | default([])) + [{
              "vm": item.item.name,
              "snapshot": (item.item.name ~ '-' ~ snapshot_name)[:67] ~ '-' ~ snapshot_ts,
              "status": ("FAILED" if (item.failed | default(false)) else "SUCCESS"),
              "error": (item.msg | default('') | regex_replace('[,\n\r]', ' ')),
              "region": item.item.location,
              "disk_type": item.item.skuName | default('unknown'),
              "resource_group": item.item.resourceGroup,
              "subscription_id": item.item.subscriptionId
            }]
          }}
      loop: "{{ snapshot_results.results }}"

    - name: Sort snapshot table
      ansible.builtin.set_fact:
        snapshot_table: "{{ snapshot_table | sort(attribute='vm') | sort(attribute='resource_group') | sort(attribute='subscription_id') }}"

    - name: Build CSV
      ansible.builtin.set_fact:
        snapshot_csv: |
          VM Name,Snapshot Name,Status,Error,Region,Disk Type,Resource Group,Subscription ID
          {% for row in snapshot_table -%}
          {{ row.vm }},{{ row.snapshot }},{{ row.status }},{{ row.error }},{{ row.region }},{{ row.disk_type }},{{ row.resource_group }},{{ row.subscription_id }}
          {% endfor %}

    - name: Write CSV to file
      ansible.builtin.copy:
        dest: "/tmp/snapshot_report.csv"
        content: "{{ snapshot_csv }}"

    # --- FIX 7: `server_list` was never defined; the body render blew up ------
    - name: Email CSV report
      community.general.mail:
        host: "ndhmail.mckesson.com"
        port: 25
        from: "jorge.chavez@mckesson.com"
        to: "{{ mail_to | join(',') }}"
        subject: "Azure Snapshot Report - {{ succeeded }} succeeded, {{ failed }} failed"
        body: |
          Hello,

          Azure VM snapshots for Prod Sat and Capsules:
          {{ vm_list_clean | join('\n') }}

          Succeeded: {{ succeeded }}
          Failed:    {{ failed }}

          Full detail attached.
        attach:
          - "/tmp/snapshot_report.csv"
      vars:
        succeeded: "{{ snapshot_table | selectattr('status','equalto','SUCCESS') | list | length }}"
        failed: "{{ snapshot_table | selectattr('status','equalto','FAILED') | list | length }}"

    - name: Fail the job if any snapshot failed
      ansible.builtin.fail:
        msg: "{{ snapshot_table | selectattr('status','equalto','FAILED') | map(attribute='vm') | list }} failed to snapshot"
      when: snapshot_table | selectattr('status','equalto','FAILED') | list | length > 0

