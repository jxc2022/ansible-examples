---
# check_web_db_services.yml
#
# READ-ONLY health check for a SUSE Linux server (SLES / openSUSE), designed to
# run as an Ansible Automation Platform job template:
#   * is nginx running and enabled?
#   * is mariadb running and enabled?
#   * what patches / package updates are pending?
#
# This playbook NEVER starts, stops, restarts or reconfigures a service, and
# NEVER installs or upgrades a package. The zypper step is a simulation
# (`--dry-run`, i.e. the equivalent of answering "no" at the confirm prompt).
#
# Self-contained: the HTML report template is inlined below, so this single
# file is the whole project - no templates/ directory needed.
#
# AAP notes
#   - Job template: set Inventory to the host holding the server, tick
#     "Privilege Escalation", and expose any of the vars below as survey fields.
#   - The execution environment is ephemeral, so the report is written ON THE
#     SERVER ITSELF (report_dir) and overwritten on each run.
#   - Counts are published with set_stats, so they appear under the job's
#     Artifacts tab and can be consumed by later nodes in a workflow.
#
# Extra vars / survey:
#   fail_on_down=false     report without failing the job (default: true)
#   check_updates=false    skip the zypper step entirely (default: true)
#   refresh_repos=false    use cached metadata instead of `zypper refresh` (default: true)
#   download_updates=true  pre-stage RPMs into the local zypper cache with
#                          `--download-only` (still installs nothing, default: false)
#   report_dir=/var/log/health_check    where the report is written on the server

- name: Health check - nginx, mariadb and pending updates
  hosts: "{{ target_hosts | default('all') }}"
  gather_facts: true
  become: true                     # zypper metadata + systemd state need root

  vars:
    fail_on_down: true
    check_ports: true
    check_updates: true
    refresh_repos: true
    download_updates: false
    nginx_service: nginx.service
    mariadb_service: mariadb.service
    nginx_port: 80
    mariadb_port: 3306
    report_dir: /var/log/health_check
    report_name: service_report.html

  tasks:

    - name: Warn if host is not SUSE
      ansible.builtin.debug:
        msg: >-
          WARNING: {{ inventory_hostname }} reports os_family
          '{{ ansible_facts.os_family }}', not 'Suse'. Unit names and the
          zypper checks may not apply.
      when: ansible_facts.os_family != 'Suse'

    # ---------------------------------------------------------------
    # Service state
    # ---------------------------------------------------------------

    - name: Collect package facts
      ansible.builtin.package_facts:
        manager: auto

    - name: Collect service facts
      ansible.builtin.service_facts:

    - name: Check nginx port
      ansible.builtin.wait_for:
        host: 127.0.0.1
        port: "{{ nginx_port }}"
        timeout: 5
      register: nginx_listen
      failed_when: false
      when: check_ports | bool

    - name: Check mariadb port
      ansible.builtin.wait_for:
        host: 127.0.0.1
        port: "{{ mariadb_port }}"
        timeout: 5
      register: mariadb_listen
      failed_when: false
      when: check_ports | bool

    # ---------------------------------------------------------------
    # Pending updates - simulation only, nothing is applied
    # ---------------------------------------------------------------

    - name: Refresh zypper repository metadata
      ansible.builtin.command:
        cmd: zypper --non-interactive refresh
      register: zypper_refresh
      changed_when: false
      failed_when: false
      when:
        - check_updates | bool
        - refresh_repos | bool
        - ansible_facts.os_family == 'Suse'

    - name: Simulate a full update (dry run - answers "no", applies nothing)
      ansible.builtin.command:
        cmd: zypper --non-interactive update --dry-run
      register: zypper_dryrun
      changed_when: false
      failed_when: false
      when:
        - check_updates | bool
        - ansible_facts.os_family == 'Suse'

    - name: Pre-stage update RPMs into the local cache (no install)
      ansible.builtin.command:
        cmd: zypper --non-interactive update --download-only
      register: zypper_download
      changed_when: false
      failed_when: false
      when:
        - check_updates | bool
        - download_updates | bool
        - ansible_facts.os_family == 'Suse'

    - name: Enumerate pending package updates
      ansible.builtin.shell:
        cmd: |
          set -o pipefail
          zypper --non-interactive --quiet list-updates 2>/dev/null | awk -F'|' '
            NF >= 6 {
              for (i = 1; i <= NF; i++) { gsub(/^[ \t]+|[ \t]+$/, "", $i) }
              if ($1 != "v") next
              printf "%s{\"repo\":\"%s\",\"name\":\"%s\",\"current\":\"%s\",\"available\":\"%s\",\"arch\":\"%s\"}", (c++ ? "," : ""), $2, $3, $4, $5, $6
            }
          ' | sed 's/^/[/; s/$/]/'
        executable: /bin/bash
      register: zypper_updates
      changed_when: false
      failed_when: false
      when:
        - check_updates | bool
        - ansible_facts.os_family == 'Suse'

    - name: Enumerate pending patches
      ansible.builtin.shell:
        cmd: |
          set -o pipefail
          zypper --non-interactive --quiet list-patches 2>/dev/null | awk -F'|' '
            NF >= 6 {
              for (i = 1; i <= NF; i++) { gsub(/^[ \t]+|[ \t]+$/, "", $i) }
              if ($2 == "Name" || $2 == "") next
              printf "%s{\"repo\":\"%s\",\"name\":\"%s\",\"category\":\"%s\",\"severity\":\"%s\",\"interactive\":\"%s\",\"status\":\"%s\"}", (c++ ? "," : ""), $1, $2, $3, $4, $5, $6
            }
          ' | sed 's/^/[/; s/$/]/'
        executable: /bin/bash
      register: zypper_patches
      changed_when: false
      failed_when: false
      when:
        - check_updates | bool
        - ansible_facts.os_family == 'Suse'

    - name: Summarise patch counts
      ansible.builtin.command:
        cmd: zypper --non-interactive patch-check
      register: zypper_patch_check
      changed_when: false
      failed_when: false
      when:
        - check_updates | bool
        - ansible_facts.os_family == 'Suse'

    - name: Parse update data
      ansible.builtin.set_fact:
        pending_updates: >-
          {{ (zypper_updates.stdout | default('[]') | trim | from_json)
             if (zypper_updates.stdout | default('') | trim) is match('^\[.*\]$') else [] }}
        pending_patches: >-
          {{ (zypper_patches.stdout | default('[]') | trim | from_json)
             if (zypper_patches.stdout | default('') | trim) is match('^\[.*\]$') else [] }}

    # ---------------------------------------------------------------
    # Assemble the record used by the report
    # ---------------------------------------------------------------

    - name: Assemble result record
      ansible.builtin.set_fact:
        svc_result:
          host: "{{ inventory_hostname }}"
          os: "{{ ansible_facts.distribution }} {{ ansible_facts.distribution_version }}"
          kernel: "{{ ansible_facts.kernel }}"
          uptime_days: "{{ (ansible_facts.uptime_seconds | default(0) | int / 86400) | round(1) }}"
          checked_updates: "{{ check_updates | bool and ansible_facts.os_family == 'Suse' }}"
          downloaded: "{{ download_updates | bool }}"
          services:
            - name: nginx
              unit: "{{ nginx_service }}"
              installed: "{{ 'nginx' in ansible_facts.packages }}"
              version: "{{ ansible_facts.packages['nginx'][0].version | default('n/a') }}"
              state: "{{ ansible_facts.services[nginx_service].state | default('not-installed') }}"
              enabled: "{{ ansible_facts.services[nginx_service].status | default('unknown') }}"
              port: "{{ nginx_port }}"
              listening: "{{ (nginx_listen.state | default('')) == 'started' }}"
            - name: mariadb
              unit: "{{ mariadb_service }}"
              installed: "{{ 'mariadb' in ansible_facts.packages }}"
              version: "{{ ansible_facts.packages['mariadb'][0].version | default('n/a') }}"
              state: "{{ ansible_facts.services[mariadb_service].state | default('not-installed') }}"
              enabled: "{{ ansible_facts.services[mariadb_service].status | default('unknown') }}"
              port: "{{ mariadb_port }}"
              listening: "{{ (mariadb_listen.state | default('')) == 'started' }}"
          updates: "{{ pending_updates | default([]) }}"
          patches: "{{ pending_patches | default([]) }}"
          patch_check: "{{ zypper_patch_check.stdout | default('') | trim }}"
          dry_run_summary: >-
            {{ (zypper_dryrun.stdout | default('') | trim
                | regex_findall('(?m)^(?:The following.*|Nothing to do\.|\d+ packages? to upgrade.*)$'))
               | join(' / ') | default('n/a', true) }}
          refresh_ok: "{{ (zypper_refresh.rc | default(0)) == 0 }}"

    - name: Show result
      ansible.builtin.debug:
        msg: >-
          {{ inventory_hostname }}:
          nginx={{ svc_result.services[0].state }},
          mariadb={{ svc_result.services[1].state }},
          updates={{ svc_result.updates | length }},
          patches={{ svc_result.patches | length }}

    # ---------------------------------------------------------------
    # Report - rendered from the inline template below and written on the
    # server, since the AAP execution environment is ephemeral.
    # ---------------------------------------------------------------

    - name: Ensure report directory exists
      ansible.builtin.file:
        path: "{{ report_dir }}"
        state: directory
        mode: "0755"

    - name: Write HTML report
      vars:
        h: "{{ svc_result }}"
        sec_patches: "{{ svc_result.patches | selectattr('category', 'defined') | selectattr('category', 'equalto', 'security') | list }}"
        down_services: "{{ svc_result.services | rejectattr('state', 'equalto', 'running') | list }}"
      ansible.builtin.copy:
        dest: "{{ report_dir }}/{{ report_name }}"
        mode: "0644"
        content: |
          <!DOCTYPE html>
          <html lang="en">
          <head>
          <meta charset="utf-8">
          <title>Health Check - {{ h.host }}</title>
          <style>
            :root {
              --bg: #f6f7f9; --card: #ffffff; --ink: #1c2024; --muted: #6b7280; --line: #e4e7eb;
              --ok: #1a7f4b;  --ok-bg: #e7f6ee;
              --bad: #b3261e; --bad-bg: #fdeceb;
              --warn: #8a6100; --warn-bg: #fdf4e3;
              --info: #1f5fa9; --info-bg: #e8f0fb;
            }
            * { box-sizing: border-box; }
            body { margin: 0; padding: 32px; background: var(--bg); color: var(--ink);
                   font: 15px/1.5 -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
            .wrap { max-width: 1150px; margin: 0 auto; }
            h1 { font-size: 22px; margin: 0 0 4px; }
            h3 { font-size: 12px; text-transform: uppercase; letter-spacing: .06em;
                 color: var(--muted); margin: 0; padding: 14px 18px 0; }
            .sub { color: var(--muted); font-size: 13px; margin-bottom: 8px; }
            .banner { background: var(--info-bg); color: var(--info); border: 1px solid #cddff5;
                      border-radius: 8px; padding: 9px 14px; font-size: 13px; margin-bottom: 24px; }
            .cards { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 24px; }
            .card { background: var(--card); border: 1px solid var(--line); border-radius: 10px;
                    padding: 14px 18px; min-width: 128px; }
            .card .n { font-size: 26px; font-weight: 600; line-height: 1.1; }
            .card .l { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
            .card.ok .n { color: var(--ok); }
            .card.bad .n { color: var(--bad); }
            .card.warn .n { color: var(--warn); }
            .panel { background: var(--card); border: 1px solid var(--line); border-radius: 10px;
                     margin-bottom: 16px; overflow: hidden; }
            .panel > header { padding: 12px 18px; border-bottom: 1px solid var(--line);
                              display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
            .panel > header .name { font-weight: 600; font-size: 16px; }
            .panel > header .meta { color: var(--muted); font-size: 12px; }
            table { width: 100%; border-collapse: collapse; }
            th, td { text-align: left; padding: 9px 18px; font-size: 14px; border-bottom: 1px solid var(--line); }
            th { font-size: 11px; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); font-weight: 600; }
            tbody tr:last-child td { border-bottom: 0; }
            .pill { display: inline-block; padding: 2px 9px; border-radius: 20px; font-size: 12px; font-weight: 600; }
            .pill.ok { background: var(--ok-bg); color: var(--ok); }
            .pill.bad { background: var(--bad-bg); color: var(--bad); }
            .pill.warn { background: var(--warn-bg); color: var(--warn); }
            .pill.info { background: var(--info-bg); color: var(--info); }
            code { font: 12px/1.4 ui-monospace, SFMono-Regular, Menlo, monospace; color: var(--muted); }
            .note { padding: 10px 18px 14px; font-size: 13px; color: var(--muted); }
            details { border-top: 1px solid var(--line); }
            details > summary { padding: 10px 18px; cursor: pointer; font-size: 13px; font-weight: 600; }
            details[open] > summary { border-bottom: 1px solid var(--line); }
            .scroll { max-height: 340px; overflow-y: auto; }
            footer { color: var(--muted); font-size: 12px; margin-top: 28px; }
          </style>
          </head>
          <body>
          <div class="wrap">

            <h1>Health Check - {{ h.host }}</h1>
            <div class="sub">
              nginx &amp; mariadb on SUSE Linux &middot;
              generated {{ ansible_date_time.date }} {{ ansible_date_time.time }} {{ ansible_date_time.tz }}
            </div>
            <div class="banner">
              Read-only run. No service was started, stopped or restarted, and no package was
              installed or upgraded - the update figures below come from
              <code>zypper update --dry-run</code>{% if h.downloaded %} plus a
              <code>--download-only</code> pre-fetch into the local cache{% endif %}.
            </div>

            <div class="cards">
              <div class="card {{ 'bad' if down_services else 'ok' }}">
                <div class="n">{{ 'FAIL' if down_services else 'OK' }}</div>
                <div class="l">Services</div>
              </div>
              <div class="card warn"><div class="n">{{ h.updates | length }}</div><div class="l">Pending updates</div></div>
              <div class="card"><div class="n">{{ h.patches | length }}</div><div class="l">Patches</div></div>
              <div class="card bad"><div class="n">{{ sec_patches | length }}</div><div class="l">Security patches</div></div>
              <div class="card"><div class="n">{{ h.uptime_days }}</div><div class="l">Uptime (days)</div></div>
            </div>

            <section class="panel">
              <header>
                <span class="name">{{ h.host }}</span>
                <span class="meta">{{ h.os }} &middot; kernel {{ h.kernel }}</span>
              </header>

              <h3>Services</h3>
              <table>
                <thead>
                  <tr><th>Service</th><th>Unit</th><th>Version</th><th>State</th><th>Boot</th><th>Port</th></tr>
                </thead>
                <tbody>
                {% for s in h.services %}
                  <tr>
                    <td><strong>{{ s.name }}</strong></td>
                    <td><code>{{ s.unit }}</code></td>
                    <td><code>{{ s.version }}</code></td>
                    <td>
                      {% if s.state == 'running' %}<span class="pill ok">running</span>
                      {% elif s.state == 'not-installed' %}<span class="pill bad">not installed</span>
                      {% else %}<span class="pill bad">{{ s.state }}</span>{% endif %}
                    </td>
                    <td>
                      {% if s.enabled == 'enabled' %}<span class="pill ok">enabled</span>
                      {% else %}<span class="pill warn">{{ s.enabled }}</span>{% endif %}
                    </td>
                    <td>
                      {% if s.listening %}<span class="pill ok">{{ s.port }} open</span>
                      {% else %}<span class="pill warn">{{ s.port }} closed</span>{% endif %}
                    </td>
                  </tr>
                {% endfor %}
                </tbody>
              </table>

              {% if h.checked_updates %}
              <h3>Pending updates (simulated, not applied)</h3>
              <div class="note">
                {% if not h.refresh_ok %}<span class="pill warn">repo refresh failed - figures may be stale</span><br>{% endif %}
                <strong>{{ h.updates | length }}</strong> package update{{ '' if h.updates | length == 1 else 's' }},
                <strong>{{ h.patches | length }}</strong> patch{{ '' if h.patches | length == 1 else 'es' }}
                {% if sec_patches %}(<span class="pill bad">{{ sec_patches | length }} security</span>){% endif %}.
                {% if h.patch_check %}<br><code>{{ h.patch_check | replace('\n', ' ') }}</code>{% endif %}
                {% if h.dry_run_summary and h.dry_run_summary != 'n/a' %}<br><code>{{ h.dry_run_summary }}</code>{% endif %}
              </div>

              {% if h.patches %}
              <details{% if sec_patches %} open{% endif %}>
                <summary>Patches ({{ h.patches | length }})</summary>
                <div class="scroll">
                <table>
                  <thead><tr><th>Patch</th><th>Category</th><th>Severity</th><th>Repository</th><th>Interactive</th></tr></thead>
                  <tbody>
                  {% for p in h.patches %}
                    <tr>
                      <td><code>{{ p.name }}</code></td>
                      <td>
                        {% if p.category | lower == 'security' %}<span class="pill bad">security</span>
                        {% else %}<span class="pill info">{{ p.category }}</span>{% endif %}
                      </td>
                      <td>
                        {% if p.severity | lower in ['critical', 'important'] %}<span class="pill bad">{{ p.severity }}</span>
                        {% elif p.severity | lower == 'moderate' %}<span class="pill warn">{{ p.severity }}</span>
                        {% else %}{{ p.severity }}{% endif %}
                      </td>
                      <td><code>{{ p.repo }}</code></td>
                      <td>{{ p.interactive }}</td>
                    </tr>
                  {% endfor %}
                  </tbody>
                </table>
                </div>
              </details>
              {% endif %}

              {% if h.updates %}
              <details>
                <summary>Package updates ({{ h.updates | length }})</summary>
                <div class="scroll">
                <table>
                  <thead><tr><th>Package</th><th>Installed</th><th>Available</th><th>Arch</th><th>Repository</th></tr></thead>
                  <tbody>
                  {% for u in h.updates %}
                    <tr>
                      <td><strong>{{ u.name }}</strong></td>
                      <td><code>{{ u.current }}</code></td>
                      <td><code>{{ u.available }}</code></td>
                      <td><code>{{ u.arch }}</code></td>
                      <td><code>{{ u.repo }}</code></td>
                    </tr>
                  {% endfor %}
                  </tbody>
                </table>
                </div>
              </details>
              {% endif %}

              {% if not h.updates and not h.patches %}
              <div class="note"><span class="pill ok">system is up to date</span></div>
              {% endif %}
              {% else %}
              <div class="note">Update check skipped on this host.</div>
              {% endif %}

            </section>

            <footer>
              Port status is checked on 127.0.0.1 only - a "closed" result can mean the service is
              bound to another interface or a UNIX socket, not that it is down.
              Generated by <code>check_web_db_services.yml</code>.
            </footer>

          </div>
          </body>
          </html>

    - name: Report location
      ansible.builtin.debug:
        msg: "HTML report written to {{ report_dir }}/{{ report_name }} on {{ inventory_hostname }}"

    # ---------------------------------------------------------------
    # AAP artifacts + exit code
    # ---------------------------------------------------------------

    - name: Publish results as AAP job artifacts
      ansible.builtin.set_stats:
        data:
          health_host: "{{ inventory_hostname }}"
          health_nginx_state: "{{ svc_result.services[0].state }}"
          health_mariadb_state: "{{ svc_result.services[1].state }}"
          health_services_down: >-
            {{ svc_result.services | rejectattr('state', 'equalto', 'running')
               | map(attribute='name') | list }}
          health_pending_updates: "{{ svc_result.updates | length }}"
          health_pending_patches: "{{ svc_result.patches | length }}"
          health_security_patches: >-
            {{ svc_result.patches | selectattr('category', 'defined')
               | selectattr('category', 'equalto', 'security') | list | length }}
          health_report_path: "{{ report_dir }}/{{ report_name }}"
        aggregate: false

    - name: Fail the job if a monitored service is not running
      ansible.builtin.assert:
        that:
          - item.state == 'running'
        fail_msg: >-
          {{ item.name }} is NOT running on {{ inventory_hostname }}
          (state={{ item.state }}) - see {{ report_dir }}/{{ report_name }}.
        success_msg: "{{ item.name }} is running."
      loop: "{{ svc_result.services }}"
      loop_control:
        label: "{{ item.name }}"
      when: fail_on_down | bool