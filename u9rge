---
# Lookup Azure VM by IP address, including the OS-visible "serial number"
# (SMBIOS System UUID, as printed by `dmidecode -t system` / `dmidecode -s system-uuid`
# on the guest OS).
#
# Background: Azure exposes a VM Unique ID (Microsoft.Compute/virtualMachines
# properties.vmId). On modern guests this string is IDENTICAL to the SMBIOS
# UUID dmidecode prints -- no transformation needed. Verified directly against
# a real Azure VM (SMBIOS 3.1.0 / dmidecode 3.6 / Hyper-V UEFI):
#   ARM vmId            : 411bfb95-967d-4b41-a701-f3fd29b468e0
#   dmidecode UUID       : 95fb1b41-7d96-414b-a701-f3fd29b468e0   <- WRONG, do not swap
# (that mismatch is what an earlier version of this playbook produced by
#  swapping when it shouldn't have)
#
# Caveat: dmidecode's own byte-ordering of the first three UUID groups
# depends on the guest's SMBIOS version -- it only reverses them itself when
# SMBIOS < 2.6 (very old/legacy guests). Virtually every current Azure VM
# reports SMBIOS >= 2.6, so ARM's vmId can be used as-is as the "serial
# number" / correlation key. If you ever hit a legacy guest where this
# doesn't match, compare its `dmidecode -t system` UUID against `az vm show
# --query vmId` directly rather than assuming a swap is needed.
#
# Note: Azure VMs generally do NOT populate a distinct/unique SMBIOS
# "Serial Number" field, so the UUID is the field actually used to correlate
# a guest OS to its Azure resource.

- name: Lookup Azure VM by IP address
  hosts: localhost
  gather_facts: false
  vars_files:
    - azure_creds.yml

  tasks:
    # 1. Convert incoming IP list string -> list
    - name: Convert server_list string to a list of IPs
      set_fact:
        # NOTE: "split" is not a Jinja/Ansible filter. Use the Python string
        # method instead (this was silently going to fail with
        # "No filter named 'split'" every run).
        ip_list: "{{ (server_list | replace('|', ',')).split(',')
                     | map('trim')
                     | select('ne','')
                     | unique
                     | list }}"

    # 2. Authenticate to Azure (read-only)
    - name: Authenticate Azure CLI
      ansible.builtin.shell: |
        az login \
          --service-principal \
          -u "{{ azure_client_id }}" \
          -p "{{ azure_client_secret }}" \
          --tenant "{{ azure_tenant_id }}"
      changed_when: false
      # Prevents the client secret / login output from being written to logs
      # or console at higher verbosity.
      no_log: true

    # 3. Build OR expression for IP matching.
    #    Matches both private IP and the *actual* public IP address (not the
    #    public IP resource ID, which is a path string like
    #    ".../publicIPAddresses/myip-01" and will never contain a dotted IP).
    - name: Build OR expression for IPs
      set_fact:
        ip_or_expression: "{{ ip_list
                              | map('regex_replace',
                                     '^(.*)$',
                                     '(privateIp =~ \"\\1\" or publicIpAddress =~ \"\\1\")')
                              | join(' or ') }}"

    # 4. Build the Azure Resource Graph query (single source of truth --
    #    the old playbook built this and then duplicated the whole query
    #    inline again in the next task; that copy is now gone).
    - name: Build Kusto query
      set_fact:
        full_query: |
          resources
          | where type =~ "microsoft.network/networkinterfaces"
          | mv-expand ipconfig = properties.ipConfigurations
          | extend privateIp = tostring(ipconfig.properties.privateIPAddress)
          | extend publicIpId = tostring(ipconfig.properties.publicIPAddress.id)
          | extend vmId = tostring(properties.virtualMachine.id)
          | join kind=leftouter (
              resources
              | where type =~ "microsoft.network/publicipaddresses"
              | extend publicIpAddress = tostring(properties.ipAddress)
              | project publicIpResourceId = id, publicIpAddress
            ) on $left.publicIpId == $right.publicIpResourceId
          | where {{ ip_or_expression }}
          | extend vmName = tostring(split(vmId, "/")[-1])
          | join kind=leftouter (
              resources
              | where type =~ "microsoft.compute/virtualmachines"
              | extend armVmUniqueId = tostring(properties.vmId)
              | project vmResourceId = id, armVmUniqueId
            ) on $left.vmId == $right.vmResourceId
          | project privateIp, publicIpAddress, vmName, vmId, armVmUniqueId, name, resourceGroup, subscriptionId

    # 5. Execute the ARG query
    - name: Run ARG query
      ansible.builtin.shell: |
        az graph query -q '{{ full_query }}' --first 1000 --output json
      register: arg_output
      changed_when: false
      # NOTE: Azure Resource Graph caps a single query at 1000 rows
      # (--first max). If you're matching against more than 1000 IPs/NICs
      # at once, this needs --skip-token pagination added.

    # 6. Parse JSON results
    - name: Parse ARG results
      set_fact:
        vm_data: "{{ arg_output.stdout | from_json }}"

    # 7. Build a list of found IPs
    - name: Build found IP list
      set_fact:
        found_ips: "{{ vm_data.data | map(attribute='privateIp') | list }}"

    # 8. Build NOT FOUND list
    - name: Build NOT FOUND list
      set_fact:
        not_found_ips: "{{ ip_list | difference(found_ips) }}"

    # 9. CSV output for FOUND VMs
    #    SerialNumber == armVmUniqueId (ARM's vmId), used as-is -- verified
    #    against a real VM to equal the guest's dmidecode UUID directly, no
    #    transform needed (see header note).
    - name: CSV output for FOUND VMs
      debug:
        msg: |
          {% if vm_data.data | length == 0 %}
          No matching VMs found for any IPs.
          {% else %}
          IP,VMName,SerialNumber(dmidecodeUUID),NICName,ResourceGroup,Subscription
          {% for item in vm_data.data %}
          {{ item.privateIp }},{{ item.vmName }},{{ item.armVmUniqueId | default('N/A') }},{{ item.name }},{{ item.resourceGroup }},{{ item.subscriptionId }}
          {% endfor %}
          {% endif %}

    # 10. CSV output for NOT FOUND IPs
    - name: CSV output for NOT FOUND IPs
      debug:
        msg: |
          {% if not_found_ips | length == 0 %}
          All IPs were found.
          {% else %}
          IP,Status
          {% for ip in not_found_ips %}
          {{ ip }},NOT_FOUND
          {% endfor %}
          {% endif %}
