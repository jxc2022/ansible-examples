---
- name: Lookup Azure VM by IP and pull guest SMBIOS serial number
  hosts: localhost
  gather_facts: false
  vars_files:
    - azure_creds.yml

  tasks:
    # 1. Convert incoming IP list string -> list
    - name: Convert server_list string to a list of IPs
      set_fact:
        ip_list: "{{ (server_list | replace('|', ',')).split(',')
                     | map('trim')
                     | select('ne','')
                     | unique
                     | list }}"

    # 2. Authenticate to Azure
    - name: Authenticate Azure CLI
      ansible.builtin.shell: |
        az login \
          --service-principal \
          -u "{{ azure_client_id }}" \
          -p "{{ azure_client_secret }}" \
          --tenant "{{ azure_tenant_id }}"
      changed_when: false
      no_log: true

    # 3. Build OR expression for IP matching (private IP or actual public IP address)
    - name: Build OR expression for IPs
      set_fact:
        ip_or_expression: "{{ ip_list
                              | map('regex_replace',
                                     '^(.*)$',
                                     '(privateIp =~ \"\\1\" or publicIpAddress =~ \"\\1\")')
                              | join(' or ') }}"

    # 4. Build the Azure Resource Graph query -- resolves IP -> VM identity only.
    #    This part remains 100% read-only.
    - name: Build Kusto query
      set_fact:
        full_query: |
          resources
          | where type =~ "microsoft.network/networkinterfaces"
          | mv-expand ipconfig = properties.ipConfigurations
          | extend privateIp = tostring(ipconfig.properties.privateIPAddress)
          | extend publicIpId = tostring(ipconfig.properties.publicIPAddress.id)
          | extend vmId = tostring(properties.virtualMachine.id)
          | join kind=leftouter (
              resources
              | where type =~ "microsoft.network/publicipaddresses"
              | extend publicIpAddress = tostring(properties.ipAddress)
              | project publicIpResourceId = id, publicIpAddress
            ) on $left.publicIpId == $right.publicIpResourceId
          | where {{ ip_or_expression }}
          | extend vmName = tostring(split(vmId, "/")[-1])
          | join kind=leftouter (
              resources
              | where type =~ "microsoft.compute/virtualmachines"
              | extend armVmUniqueId = tostring(properties.vmId)
              | project vmResourceId = id, armVmUniqueId
            ) on $left.vmId == $right.vmResourceId
          | project privateIp, publicIpAddress, vmName, vmId, armVmUniqueId, name, resourceGroup, subscriptionId

    # 5. Execute the ARG query (read-only)
    - name: Run ARG query
      ansible.builtin.shell: |
        az graph query -q '{{ full_query }}' --first 1000 --output json
      register: arg_output
      changed_when: false
      # NOTE: Azure Resource Graph caps a single query at 1000 rows without
      # --skip-token pagination.

    # 6. Parse JSON results
    - name: Parse ARG results
      set_fact:
        vm_data: "{{ arg_output.stdout | from_json }}"

    # 7. Build a list of found / not-found IPs
    - name: Build found IP list
      set_fact:
        found_ips: "{{ vm_data.data | map(attribute='privateIp') | list }}"

    - name: Build NOT FOUND list
      set_fact:
        not_found_ips: "{{ ip_list | difference(found_ips) }}"

    # 8. Run Command: read the real SMBIOS serial number from each matched
    #    VM. Uses --ids so it works regardless of which subscription/RG the
    #    VM lives in. ignore_errors so one unreachable/stopped VM (agent not
    #    responding, VM deallocated, etc.) doesn't abort the whole batch --
    #    it's caught and reported per-VM below instead.
    - name: Run dmidecode serial-number lookup on each matched VM (Linux only)
      ansible.builtin.command:
        argv:
          - az
          - vm
          - run-command
          - invoke
          - --ids
          - "{{ item.vmId }}"
          - --command-id
          - RunShellScript
          - --scripts
          - "dmidecode -s system-serial-number"
          - --output
          - json
      loop: "{{ vm_data.data }}"
      loop_control:
        loop_var: item
      register: run_command_results
      changed_when: false
      ignore_errors: true
      when: vm_data.data | length > 0

    # 9. Extract the serial number string from each Run Command response and
    #    attach it to the matching VM record.
    #    az vm run-command invoke returns JSON like:
    #      {"value": [{"message": "Enable succeeded: \n[stdout]\n<serial>\n\n[stderr]\n"}]}
    - name: Reset enriched VM list
      set_fact:
        vm_list_enriched: []

    - name: Attach real SMBIOS serial number to each VM record
      vars:
        rc_ok: "{{ (rc_result.rc | default(1)) == 0 }}"
        rc_message: "{{ ((rc_result.stdout | from_json).value[0].message) if rc_ok else '' }}"
        serial_val: >-
          {{ (rc_message.split('[stdout]')[1].split('[stderr]')[0] | trim)
             if (rc_ok and '[stdout]' in rc_message and '[stderr]' in rc_message)
             else ('ERROR: run-command failed (rc=' ~ (rc_result.rc | default('unknown')) ~ ')') }}
      set_fact:
        vm_list_enriched: "{{ vm_list_enriched + [ vm_data.data[idx] | combine({'serialNumber': serial_val}) ] }}"
      loop: "{{ run_command_results.results | default([]) }}"
      loop_control:
        loop_var: rc_result
        index_var: idx
      when: vm_data.data | length > 0

    # 10. CSV output for FOUND VMs -- SerialNumber is now the actual
    #     dmidecode Serial Number string, suitable to feed straight into
    #     ServiceNow CMDB. VmUUID (ARM vmId) is included too as a stable
    #     correlation key, since it's cheap/read-only to obtain.
    - name: CSV output for FOUND VMs
      debug:
        msg: |
          {% if vm_list_enriched | length == 0 %}
          No matching VMs found for any IPs.
          {% else %}
          IP,VMName,SerialNumber,VmUUID,NICName,ResourceGroup,Subscription
          {% for item in vm_list_enriched %}
          {{ item.privateIp }},{{ item.vmName }},{{ item.serialNumber }},{{ item.armVmUniqueId | default('N/A') }},{{ item.name }},{{ item.resourceGroup }},{{ item.subscriptionId }}
          {% endfor %}
          {% endif %}

    # 11. CSV output for NOT FOUND IPs
    - name: CSV output for NOT FOUND IPs
      debug:
        msg: |
          {% if not_found_ips | length == 0 %}
          All IPs were found.
          {% else %}
          IP,Status
          {% for ip in not_found_ips %}
          {{ ip }},NOT_FOUND
          {% endfor %}
          {% endif %}

