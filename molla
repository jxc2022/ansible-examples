---

- name: Build dynamic inventory
  hosts: localhost
  connection: local
  gather_facts: false

  vars:
    server_list: |
      epmsatmddcn01
epmcapazn01

  tasks:

    - name: Convert server_list string to a list
      ansible.builtin.set_fact:
        servers: >-
          {{ server_list.splitlines() | map('trim') | select('ne', '') | unique | list }}

    - name: Fail early if no servers were supplied
      ansible.builtin.fail:
        msg: "server_list is empty - nothing to check."
      when: servers | length == 0

    - name: Create dynamic group linux_servers
      ansible.builtin.add_host:
        name: "{{ item }}"
        groups: linux_servers
      loop: "{{ servers }}"
      changed_when: false

    - name: Show dynamically added servers
      ansible.builtin.debug:
        msg: "Added {{ servers | join(', ') }} to group linux_servers"


- name: Patch the RHEL Satellite server
  hosts: linux_servers
  become: true
  serial: 1
  max_fail_percentage: 0

  vars: &patch_vars

    # --- Targets -------------------------------------------------------------
    satellite_host: "satellite.molly.lab"

    capsule_hosts: []
    # capsule_hosts:
    #   - capsule1.molly.lab
    #   - capsule2.molly.lab

    satellite_packages_update_extra_args: ""
    satellite_reboot_timeout: 600
    satellite_reboot_connect_timeout: 5
    satellite_reboot_reconnect_delay: 30
    capsule_require_healthy_satellite: true
    report_local_dir: "/tmp/reports"
    recipient: "jorge.chavez@mckesson.com"
    report_email_enabled: true
    report_email_smtp_host: "smtp.gmail.com"

  tasks:
    - name: Patch  Satellite
      block:

        - name: Record that the Satellite play actually ran
          ansible.builtin.set_fact:
            satellite_play_ran: true
          delegate_to: localhost
          delegate_facts: true
          run_once: true
          become: false

        - name: Verify satellite-maintain is installed
          ansible.builtin.command: rpm -q satellite-maintain
          changed_when: false

        - name: Check for available package updates
          ansible.builtin.command: satellite-maintain packages check-update
          register: sat_check_update
          changed_when: false
          failed_when: false

        - name: Show available updates
          ansible.builtin.debug:
            var: sat_check_update.stdout_lines


        - name: Update base operating system packages
          ansible.builtin.command: >-
            satellite-maintain packages update --assumeyes
            {{ satellite_packages_update_extra_args }}
          register: sat_update
          changed_when: true

        - name: Show patch output
          ansible.builtin.debug:
            var: sat_update.stdout_lines

        - name: Reboot Satellite after patching
          ansible.builtin.reboot:
            reboot_timeout: "{{ satellite_reboot_timeout }}"
            connect_timeout: "{{ satellite_reboot_connect_timeout }}"
            pre_reboot_delay: 5
            post_reboot_delay: "{{ satellite_reboot_reconnect_delay }}"
            test_command: satellite-maintain service status --brief

        - name: Verify all Satellite services are running
          ansible.builtin.command: satellite-maintain service status
          register: sat_service_status
          changed_when: false


        - name: Record per-host result for the emailed report
          ansible.builtin.set_fact:
            patch_report_role: satellite
            patch_report_status: >-
              {{ 'ok' if sat_service_status.rc == 0 and sat_api_ok | default(true) | bool
                 else 'unhealthy' }}
            patch_report_update_rc: "{{ sat_update.rc }}"
            patch_report_reboot_performed: true
            patch_report_service_status_rc: "{{ sat_service_status.rc }}"
            patch_report_api_ok: "{{ sat_api_ok | default(omit) }}"

        - name: Record whether the Satellite finished healthy, for the Capsule play
          ansible.builtin.set_fact:
            satellite_patch_ok: >-
              {{ hostvars['localhost'].satellite_patch_ok | default(true) | bool
                 and sat_service_status.rc == 0
                 and sat_api_ok | default(true) | bool }}
          delegate_to: localhost
          delegate_facts: true
          become: false

        - name: Fail the Satellite if it came back unhealthy
          ansible.builtin.fail:
            msg: >-
              Satellite finished patching but is unhealthy
              (service status rc={{ sat_service_status.rc }},
              api ok={{ sat_api_ok | default('not checked') }}).
          when: sat_service_status.rc != 0 or not sat_api_ok | default(true) | bool

      rescue:
        - name: Record the failure for the report
          ansible.builtin.set_fact:
            patch_report_role: satellite
            patch_report_status: failed
            patch_report_failed_task: "{{ ansible_failed_task.name | default('unknown') }}"
            patch_report_error: >-
              {{ ansible_failed_result.msg
                 | default(ansible_failed_result.stderr | default('see job output')) }}

        - name: Flag the run as failed and block the Capsule play
          ansible.builtin.set_fact:
            satellite_patch_ok: false
            patch_run_failed: true
          delegate_to: localhost
          delegate_facts: true
          become: false

        - name: Stop patching -- the report play still runs
          ansible.builtin.meta: end_play


# =============================================================================
- name: Patch Capsules one at a time
  hosts: "{{ capsule_hosts }}"
  become: true
  serial: 1
  max_fail_percentage: 0
  vars:
    <<: *patch_vars

  tasks:

    - name: Refuse to patch Capsules if the Satellite did not finish healthy
      ansible.builtin.meta: end_play
      when:
        - capsule_require_healthy_satellite | bool
        - hostvars['localhost'].satellite_play_ran | default(false) | bool
        - not hostvars['localhost'].satellite_patch_ok | default(false) | bool

    - name: Patch the Capsule
      block:

        - name: Verify satellite-maintain is installed
          ansible.builtin.command: rpm -q satellite-maintain
          changed_when: false

        - name: Check for active content sync tasks on this Capsule (optional)
          ansible.builtin.command: >-
            hammer --username {{ hammer_username }} --password {{ hammer_password }}
            task list --search "state=running and
            (label=Actions::Katello::CapsuleContent::Sync or
            label=Actions::Katello::CapsuleContent::UpdateContentCounts)"
          register: capsule_sync_tasks
          changed_when: false
          no_log: true
          delegate_to: "{{ satellite_host }}"
          when:
            - capsule_check_sync_status | bool
            - satellite_host | default('', true) | length > 0

        - name: Fail if this Capsule has an active sync task
          ansible.builtin.fail:
            msg: >-
              {{ inventory_hostname }} appears to have an active content sync task.
              Re-run once it completes, or investigate before patching.
          when:
            - capsule_check_sync_status | bool
            - capsule_sync_tasks.stdout is defined
            - inventory_hostname in capsule_sync_tasks.stdout


        - name: Check for available package updates
          ansible.builtin.command: satellite-maintain packages check-update
          register: cap_check_update
          changed_when: false
          failed_when: false

        - name: Show available updates
          ansible.builtin.debug:
            var: cap_check_update.stdout_lines

        - name: run update
          ansible.builtin.command: >-
            satellite-maintain packages update --assumeyes
            {{ satellite_packages_update_extra_args }}
          register: cap_update
          changed_when: true

        - name: Show patch output
          ansible.builtin.debug:
            var: cap_update.stdout_lines

        - name: Reboot Capsule after patching
          ansible.builtin.reboot:
            reboot_timeout: "{{ satellite_reboot_timeout }}"
            connect_timeout: "{{ satellite_reboot_connect_timeout }}"
            pre_reboot_delay: 5
            post_reboot_delay: "{{ satellite_reboot_reconnect_delay }}"
            test_command: satellite-maintain service status --brief

        - name: Verify all Capsule services are running
          ansible.builtin.command: satellite-maintain service status
          register: cap_service_status
          changed_when: false


        - name: Record per-host result for the emailed report
          ansible.builtin.set_fact:
            patch_report_role: capsule
            patch_report_status: >-
              {{ 'ok' if cap_service_status.rc == 0 and cap_api_ok | default(true) | bool
                 else 'unhealthy' }}
            patch_report_update_rc: "{{ cap_update.rc }}"
            patch_report_reboot_performed: true
            patch_report_service_status_rc: "{{ cap_service_status.rc }}"
            patch_report_api_ok: "{{ cap_api_ok | default(omit) }}"

        - name: Fail this Capsule if it came back unhealthy
          ansible.builtin.fail:
            msg: >-
              Capsule finished patching but is unhealthy
              (service status rc={{ cap_service_status.rc }},
              api ok={{ cap_api_ok | default('not checked') }}).
          when: cap_service_status.rc != 0 or not cap_api_ok | default(true) | bool

      rescue:
        - name: Record the failure for the report
          ansible.builtin.set_fact:
            patch_report_role: capsule
            patch_report_status: failed
            patch_report_failed_task: "{{ ansible_failed_task.name | default('unknown') }}"
            patch_report_error: >-
              {{ ansible_failed_result.msg
                 | default(ansible_failed_result.stderr | default('see job output')) }}

        - name: Flag the run as failed
          ansible.builtin.set_fact:
            patch_run_failed: true
          delegate_to: localhost
          delegate_facts: true
          become: false

        - name: Stop patching further Capsules -- the report play still runs
          ansible.builtin.meta: end_play


- name: Render and email the patch run report
  hosts: localhost
  connection: local
  become: false
  gather_facts: true
  vars:
    <<: *patch_vars
    report_path: "{{ report_local_dir }}/satellite_patch_report_{{ ansible_date_time.iso8601_basic_short }}.txt"
    report_targets: >-
      {{ ([satellite_host] if satellite_host | default('', true) | length > 0 else [])
         + (capsule_hosts | default([])) }}

  tasks:
    - name: Ensure the local report directory exists
      ansible.builtin.file:
        path: "{{ report_local_dir }}"
        state: directory
        mode: "0755"

    - name: Render patch report
      ansible.builtin.copy:
        dest: "{{ report_path }}"
        mode: "0644"
        content: |
          ===============================================================================
           RHEL Satellite / Capsule patch report
          ===============================================================================
           Generated : {{ ansible_date_time.iso8601 }}
           Control   : {{ ansible_fqdn | default('localhost') }}
           Result    : {{ 'FAILED' if patch_run_failed | default(false) | bool else 'SUCCESS' }}
           Hosts     : {{ report_targets | length }} targeted
          ===============================================================================

          {{ 'HOST'.ljust(34) }}{{ 'ROLE'.ljust(11) }}{{ 'RESULT'.ljust(14) }}{{ 'REBOOTED'.ljust(10) }}
          {{ '-' * 79 }}
          {% for h in report_targets %}
          {% set hv = hostvars[h] | default({}) %}
          {{ h[:33].ljust(34) }}{{ (hv.patch_report_role | default('-'))[:10].ljust(11) }}{{ (hv.patch_report_status | default('not attempted') | trim)[:13].ljust(14) }}{{ ('yes' if hv.patch_report_reboot_performed | default(false) | bool else 'no').ljust(10) }}
          {% endfor %}

          -------------------------------------------------------------------------------
           Detail
          -------------------------------------------------------------------------------
          {% for h in report_targets %}
          {% set hv = hostvars[h] | default({}) %}

           {{ h }} ({{ hv.patch_report_role | default('unknown role') }})
             status              : {{ hv.patch_report_status | default('not attempted') | trim }}
          {% if hv.patch_report_status is not defined %}
             (never reached -- the run stopped before it, or it was skipped
              because the Satellite did not finish healthy)
          {% elif hv.patch_report_status | trim == 'failed' %}
             failed task         : {{ hv.patch_report_failed_task | default('unknown') }}
             error               : {{ hv.patch_report_error | default('see job output') | trim }}
          {% else %}
             update              : rc={{ hv.patch_report_update_rc | default('-') }}
             reboot performed    : {{ 'yes' if hv.patch_report_reboot_performed | default(false) | bool else 'no' }}
             service status      : rc={{ hv.patch_report_service_status_rc | default('-') }}
             api check           : {{ hv.patch_report_api_ok | default('not checked') }}
          {% endif %}
          {% endfor %}

 
    - name: Email patch report
      community.general.mail:
        host: "{{ report_email_smtp_host }}"
        port: "{{ report_email_smtp_port }}"
        username: "{{ report_email_smtp_username | default(omit, true) }}"
        password: "{{ report_email_smtp_password | default(omit, true) }}"
        secure: "{{ report_email_smtp_secure }}"
        from: "jorge.chavez@mckesson.com"
        to: "{{ report_email_to if report_email_to is string else report_email_to | join(',') }}"
        subject: >-
          [{{ 'FAILED' if patch_run_failed | default(false) | bool else 'OK' }}]
          Satellite/Capsule patch report - {{ ansible_date_time.date }}
        body: "{{ lookup('file', report_path) }}"
        attach: "{{ [report_path] if report_email_attach_report | bool else omit }}"
      when: report_email_enabled | bool

    - name: Fail the run if any host failed to patch
      ansible.builtin.fail:
        msg: "One or more hosts failed to patch. See the report at {{ report_path }}."
      when: patch_run_failed | default(false) | bool
